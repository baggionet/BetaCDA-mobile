{
  "expo": {
    "name": "BetaCheck",
    "slug": "BetaCheck-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/Logo-betacheckFondoTrans.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.betacheck.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para confirmar tu identidad al registrar tu asistencia."
      }
    },
    "android": {
      "package": "com.baggionet.betacheck",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E3A5F"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para confirmar tu identidad al registrar tu asistencia."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.24",
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "scheme": "betacheck",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b9913af-b3f4-446b-8e34-5a099f89e928"
      }
    },
    "owner": "baggionet"
  }
}
